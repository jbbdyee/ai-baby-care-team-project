APP_ENV=development
APP_TIMEZONE=Asia/Seoul
TEST_MODE=true

# PostgreSQL·Redis (Docker Compose 서비스 이름 기준)
POSTGRES_DSN=postgresql+psycopg://postgres:password@postgres:5432/baby_ai
REDIS_URL=redis://redis:6379/0

# OpenAI API·STT
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_RESPONSE_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
STT_MODEL=gpt-4o-mini-transcribe

# Backend → MCP 서버
BABY_CARE_MCP_URL=http://baby-care-mcp:8101/mcp
BABY_INFO_MCP_URL=http://baby-info-mcp:8102/mcp
MCP_HOST=0.0.0.0
MCP_STREAMABLE_HTTP_PATH=/mcp

# Ollama Embedding
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIMENSION=768
OLLAMA_TIMEOUT_SECONDS=30
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.70
RAG_MAX_CONTEXT_CHARS=8000

# 병원 공공데이터
PUBLIC_DATA_API_KEY=
PUBLIC_DATA_BASE_URL=
PEDIATRIC_API_KEY=
EMERGENCY_API_KEY=
PEDIATRIC_API_URL=
EMERGENCY_API_URL=
EXTERNAL_API_TIMEOUT_SECONDS=5
EXTERNAL_API_RETRY_COUNT=1

# 업로드 제한. Backend와 Baby Care MCP가 같은 Docker volume을 사용합니다.
MAX_IMAGE_SIZE_MB=10
MAX_AUDIO_SIZE_MB=20
IMAGE_TEMP_DIRECTORY=/app/uploads
IMAGE_MAX_BYTES=10485760
IMAGE_MIN_WIDTH=224
IMAGE_MIN_HEIGHT=224
IMAGE_DARK_THRESHOLD=35
IMAGE_BRIGHT_THRESHOLD=235
IMAGE_BLUR_THRESHOLD=20
